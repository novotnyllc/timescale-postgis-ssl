FROM timescale/timescaledb-ha:pg18.3-ts2.26.4-oss

# Switch to root user so the wrapper can prepare mounted volumes.
USER root

# The base image already includes openssl.
RUN command -v openssl

# Add init scripts while setting permissions
COPY --chmod=755 init-ssl.sh /docker-entrypoint-initdb.d/init-ssl.sh
COPY --chmod=644 init-extensions.sql /docker-entrypoint-initdb.d/init-extensions.sql
COPY --chmod=755 wrapper.sh /usr/local/bin/wrapper.sh

# Run the wrapper as root so the Postgres entrypoint can prepare mounted volumes
# before dropping privileges to postgres.
USER root

# Override the ENTRYPOINT with a wrapper script
ENTRYPOINT ["wrapper.sh"]

# Start postgres listening on port 5432
CMD ["postgres", "--port=5432"]
